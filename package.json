{
  "name": "vtesitaly-foto",
  "type": "module",
  "version": "0.1.0",
  "description": "Photo archive of the Italian VTES community (Astro, deployed to GitHub Pages at foto.vtesitaly.com).",
  "license": "MIT",
  "author": "VTES Italy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilofruttaldo/VtesItaly.Foto.git"
  },
  "homepage": "https://foto.vtesitaly.com",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/wasi-bindings.mjs",
    "add-album": "node scripts/add-album.mjs",
    "photos": "node scripts/build-photos.mjs",
    "dev": "npm run photos && astro dev --port 4323",
    "prebuild": "node scripts/build-photos.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "ci:verify": "npm audit --omit=dev && npm run lint && npm run format:check && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "sharp": "^0.35.4"
  },
  "//overrides": "esbuild: aliased to esbuild-wasm (same API, no native binary) because Smart App Control on the dev machine blocks the unsigned esbuild.exe; build-time only.",
  "overrides": {
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.57.1",
    "astro-eslint-parser": "^3.2.0",
    "esbuild": "npm:esbuild-wasm@0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
