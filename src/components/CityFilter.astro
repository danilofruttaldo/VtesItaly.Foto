---
/* Principato toggles for the home: switching some on shows only their albums,
   none on shows all. Without JavaScript they stay links to the principato
   pages. On a phone the row scrolls sideways instead of wrapping. */
interface Props {
  cities: { slug: string; name: string; count: number }[];
}

const { cities } = Astro.props;
---

<nav class="filter" aria-label="Filtra per principato" data-city-filter>
  {cities.map((c) => (
    <a href={`/principati/${c.slug}/`} class="chip" data-city={c.slug}>
      {c.name} <span class="chip__count">{c.count}</span>
    </a>
  ))}
</nav>

<script>
  import { initCityFilter } from '../scripts/city-filter';
  initCityFilter();
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 8px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-contrast);
    font-size: 0.9rem;
    white-space: nowrap;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .chip:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-base);
    font-weight: 700;
  }
  .chip__count {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  @media (max-width: 640px) {
    .filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      /* Bleed to the screen edges so the row visibly continues. */
      margin-inline: -16px;
      padding-inline: 16px;
      scroll-padding-inline: 16px;
    }
    .filter::-webkit-scrollbar {
      display: none;
    }
  }
</style>
