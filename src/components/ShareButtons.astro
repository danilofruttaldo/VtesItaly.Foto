---
import { shareLinks } from '../utils/share';

interface Props {
  title: string;
}

const { title } = Astro.props;
// The public address, also when built or previewed on localhost.
const url = new URL(Astro.url.pathname, Astro.site).href;
const icons = {
  fb: 'M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z',
  x: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  wa: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z',
  tg: 'M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0h-.056zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
};
---

<div class="share">
  <span class="share__label">Condividi</span>
  <div class="share__buttons">
    {shareLinks(url, title).map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        class={`share__btn share__btn--${l.network}`}
        title={`Condividi su ${l.name}`}
        aria-label={`Condividi su ${l.name}`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d={icons[l.network]} />
        </svg>
      </a>
    ))}
    <button
      type="button"
      class="share__btn share__btn--copy"
      data-url={url}
      title="Copia link"
      aria-label="Copia link"
      hidden
    >
      <svg
        aria-hidden="true"
        class="share__copy-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
      </svg>
      <svg
        aria-hidden="true"
        class="share__check-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
  import '../scripts/share';
</script>

<style>
  .share {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .share__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .share__buttons {
    display: flex;
    gap: 8px;
  }
  .share__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    background: none;
    padding: 0;
  }
  .share__btn[hidden] {
    display: none;
  }
  .share__btn:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
  .share__btn--fb:hover {
    color: #1877f2;
    border-color: #1877f2;
  }
  .share__btn--x:hover {
    color: var(--color-contrast);
    border-color: var(--color-contrast);
  }
  .share__btn--wa:hover {
    color: #25d366;
    border-color: #25d366;
  }
  .share__btn--tg:hover {
    color: #0088cc;
    border-color: #0088cc;
  }
  .share__btn--copy .share__check-icon {
    display: none;
  }
  .share__btn--copy.copied {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }
  .share__btn--copy.copied .share__copy-icon {
    display: none;
  }
  .share__btn--copy.copied .share__check-icon {
    display: block;
  }
  @media (max-width: 544px) {
    .share {
      flex-direction: column;
      gap: 8px;
    }
    .share__buttons {
      flex-wrap: wrap;
      justify-content: center;
    }
    .share__btn {
      width: 44px;
      height: 44px;
    }
  }
</style>
