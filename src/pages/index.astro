---
import Base from '../layouts/Base.astro';
import AlbumGrid from '../components/AlbumGrid.astro';
import CityFilter from '../components/CityFilter.astro';
import { citiesOf, loadAlbums } from '../utils/albums';

const albums = loadAlbums();
const photos = albums.reduce((n, a) => n + a.photos.length, 0);
---

<Base
  title="Foto VTES Italy"
  description="Le foto dei tornei e degli eventi della community italiana di Vampire: The Eternal Struggle."
  image="/images/og-default.jpg"
  imageWidth={1200}
  imageHeight={630}
>
  <h1>Foto della community</h1>
  <p class="muted" data-album-summary aria-live="polite">
    {albums.length} album, {photos} foto.
  </p>
  <CityFilter cities={citiesOf(albums)} />
  <AlbumGrid albums={albums} />
</Base>
