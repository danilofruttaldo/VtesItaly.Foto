---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import AlbumGrid from '../../../components/AlbumGrid.astro';
import { citiesOf, coverImage, loadAlbums } from '../../../utils/albums';
import { PRINCIPATI } from '../../../utils/principati';

export const getStaticPaths = (() =>
  citiesOf(loadAlbums()).map((c) => ({ params: { city: c.slug }, props: { city: c } }))) satisfies GetStaticPaths;

const { city } = Astro.props as { city: { slug: string; name: string } };
const all = loadAlbums();
const albums = all.filter((a) => a.city === city.slug);
const photos = albums.reduce((n, a) => n + a.photos.length, 0);
---

<Base
  title={`Foto da ${city.name}`}
  description={`Le foto dei tornei e degli eventi VTES a ${city.name}: ${albums.length} album, ${photos} foto.`}
  {...coverImage(albums[0].cover)}
>
  <a href="/" class="back">
    &larr; Tutti gli album
  </a>
  <h1>Foto da {city.name}</h1>
  <p class="muted">
    {albums.length} album, {photos} foto
    {PRINCIPATI.has(city.slug) && (
      <>
        {' · '}
        <a href={`https://vtesitaly.com/principati/${city.slug}/`}>Principato di {city.name}</a>
      </>
    )}
  </p>
  <AlbumGrid albums={albums} hideCity />
</Base>
