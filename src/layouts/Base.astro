---
import '../styles/global.css';
import { twitterCard } from '../utils/albums';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social previews. */
  image?: string;
  /** Size of `image`, when known: picks the Twitter card and fills og:image:width/height. */
  imageWidth?: number;
  imageHeight?: number;
  /** Keeps the page out of search results (the 404). */
  noindex?: boolean;
}

const { title, description, image, imageWidth, imageHeight, noindex } = Astro.props;
const fullTitle = title === 'Foto VTES Italy' ? title : `${title} | Foto VTES Italy`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/logo-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121416" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Foto VTES Italy" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageWidth && imageHeight && <meta property="og:image:width" content={String(imageWidth)} />}
    {ogImage && imageWidth && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta name="twitter:card" content={ogImage ? twitterCard(imageWidth, imageHeight) : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand">
          <img src="/images/logo-144.webp" alt="" width="36" height="36" />
          <span>Foto VTES Italy</span>
        </a>
        <a href="https://vtesitaly.com/" target="_blank" rel="noopener">
          vtesitaly.com &rarr;
        </a>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        Archivio fotografico della community italiana di Vampire: The Eternal Struggle. Le foto sono degli eventi VTES
        Italy: per farne rimuovere una, scrivi a <a href="mailto:info@vtesitaly.com">info@vtesitaly.com</a>.
      </div>
    </footer>
    <button type="button" id="back-to-top" class="back-to-top" aria-label="Torna in cima" title="Torna in cima">
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script>
      import '../scripts/back-to-top';
    </script>
  </body>
</html>
